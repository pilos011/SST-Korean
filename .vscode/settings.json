{
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "editor.renderWhitespace": "boundary",
    "C_Cpp.default.compilerPath": "gcc",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src"
    ],
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    }
}
